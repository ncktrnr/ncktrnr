<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */
function ncktrnr_tw_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * Gives long-form text a reading measure.
 *
 * Basic pages compose their layout in Layout Builder, so the node template
 * cannot cap the width – the work page's card grid needs the full container.
 * The measure therefore belongs to the text itself rather than to the page,
 * and these are the two fields that carry prose.
 *
 * Page-level renders only. A teaser or a card is not a page of prose, and one
 * silently inheriting a 76ch cap from here would be a puzzle to track down.
 * The two modes that qualify are `full` and `_custom` – the latter is what
 * Layout Builder's field blocks report, and it is how every Basic page gets
 * here, so narrowing this to `full` alone drops the measure from About.
 */
function ncktrnr_tw_preprocess_field(array &$variables): void {
  $prose_fields = [
    'node' => ['field_content'],
    'block_content' => ['body'],
  ];

  $entity_type = $variables['entity_type'] ?? '';
  $field_name = $variables['field_name'] ?? '';
  $view_mode = $variables['element']['#view_mode'] ?? '';

  if (!in_array($view_mode, ['full', '_custom'], TRUE)) {
    return;
  }

  if (in_array($field_name, $prose_fields[$entity_type] ?? [], TRUE)) {
    $variables['attributes']['class'][] = 'prose';
    $variables['attributes']['class'][] = 'lg:prose-lg';
  }
}
